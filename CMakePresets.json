{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Ninja + LLVM Clang (C++20 modules)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" }
    ]
}
